# Aurora fish + fzf colours · generated by matugen from your wallpaper — edits get overwritten
# Universal variables: every open fish shell picks them up instantly.
set -U fish_color_normal          {{colors.on_surface.default.hex_stripped}}
set -U fish_color_command         {{colors.primary.default.hex_stripped}}
set -U fish_color_keyword         {{colors.tertiary.default.hex_stripped}}
set -U fish_color_quote           f5d58a
set -U fish_color_redirection     {{colors.secondary.default.hex_stripped}}
set -U fish_color_end             {{colors.tertiary.default.hex_stripped}}
set -U fish_color_error           {{colors.error.default.hex_stripped}}
set -U fish_color_param           {{colors.on_surface_variant.default.hex_stripped}}
set -U fish_color_option          {{colors.secondary.default.hex_stripped}}
set -U fish_color_comment         {{colors.outline.default.hex_stripped}}
set -U fish_color_operator        {{colors.secondary.default.hex_stripped}}
set -U fish_color_escape          f9a8d4
set -U fish_color_autosuggestion  {{colors.outline.default.hex_stripped}}
set -U fish_color_valid_path      --underline
set -U fish_color_cwd             {{colors.primary.default.hex_stripped}}
set -U fish_color_user            {{colors.secondary.default.hex_stripped}}
set -U fish_color_host            {{colors.tertiary.default.hex_stripped}}
set -U fish_color_search_match    --background={{colors.surface_container_high.default.hex_stripped}}
set -U fish_color_selection       --background={{colors.surface_container_high.default.hex_stripped}}
set -U fish_pager_color_prefix    {{colors.primary.default.hex_stripped}} --bold
set -U fish_pager_color_completion {{colors.on_surface_variant.default.hex_stripped}}
set -U fish_pager_color_description {{colors.outline.default.hex_stripped}}
set -U fish_pager_color_progress  {{colors.on_primary.default.hex_stripped}} --background={{colors.primary.default.hex_stripped}}
set -U fish_pager_color_selected_background --background={{colors.surface_container_high.default.hex_stripped}}

set -Ux FZF_DEFAULT_OPTS "--color=bg+:{{colors.surface_container_high.default.hex}},bg:-1,fg:{{colors.on_surface_variant.default.hex}},fg+:{{colors.on_surface.default.hex}},hl:{{colors.primary.default.hex}},hl+:{{colors.primary.default.hex}},info:{{colors.outline.default.hex}},prompt:{{colors.tertiary.default.hex}},pointer:{{colors.primary.default.hex}},marker:#f9a8d4,spinner:{{colors.secondary.default.hex}},header:{{colors.secondary.default.hex}},border:{{colors.surface_container_high.default.hex}} --border=rounded --layout=reverse --height=40%"
