  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "{{colors.outline.default.hex}}", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"], "settings": { "foreground": "{{colors.primary.default.hex}}" } },
    { "scope": ["keyword.operator", "punctuation.accessor"], "settings": { "foreground": "{{colors.primary_fixed_dim.default.hex}}" } },
    { "scope": ["string", "string.quoted", "string.template", "markup.inline.raw"], "settings": { "foreground": "#f5d58a" } },
    { "scope": ["constant.character.escape", "string.regexp"], "settings": { "foreground": "#f9a8d4" } },
    { "scope": ["constant.numeric", "constant.language", "constant.other", "support.constant"], "settings": { "foreground": "#f9a8d4" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call", "variable.function"], "settings": { "foreground": "{{colors.secondary.default.hex}}" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.other.inherited-class", "storage.type.class"], "settings": { "foreground": "{{colors.tertiary.default.hex}}" } },
    { "scope": ["variable", "meta.definition.variable"], "settings": { "foreground": "{{colors.on_surface.default.hex}}" } },
    { "scope": ["variable.parameter"], "settings": { "foreground": "{{colors.on_surface_variant.default.hex}}", "fontStyle": "italic" } },
    { "scope": ["variable.other.property", "variable.other.object.property", "support.variable.property", "meta.object-literal.key"], "settings": { "foreground": "{{colors.on_surface_variant.default.hex}}" } },
    { "scope": ["variable.language", "variable.language.this", "variable.language.self"], "settings": { "foreground": "{{colors.tertiary.default.hex}}", "fontStyle": "italic" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "{{colors.primary.default.hex}}" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "{{colors.secondary.default.hex}}", "fontStyle": "italic" } },
    { "scope": ["punctuation", "meta.brace"], "settings": { "foreground": "{{colors.outline.default.hex}}" } },
    { "scope": ["entity.name.namespace", "entity.name.module"], "settings": { "foreground": "{{colors.tertiary.default.hex}}" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "{{colors.primary.default.hex}}", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "{{colors.secondary.default.hex}}" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#6ee7c8" } },
    { "scope": ["markup.deleted", "invalid"], "settings": { "foreground": "{{colors.error.default.hex}}" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "{{colors.secondary.default.hex}}" } }
  ],
  "semanticTokenColors": {
    "function": "{{colors.secondary.default.hex}}",
    "method": "{{colors.secondary.default.hex}}",
    "type": "{{colors.tertiary.default.hex}}",
    "class": "{{colors.tertiary.default.hex}}",
    "interface": "{{colors.tertiary.default.hex}}",
    "enumMember": "#f9a8d4",
    "parameter": "{{colors.on_surface_variant.default.hex}}",
    "property": "{{colors.on_surface_variant.default.hex}}",
    "namespace": "{{colors.tertiary.default.hex}}"
  }
}
